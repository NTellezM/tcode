{
  "name": "tcode",
  "displayName": "Tcode",
  "description": "Soporte de lenguaje para Tcode: resaltado, completado (con la biblioteca estándar), diagnósticos, formato, ir a la definición y la firma de la función al pasar por encima",
  "version": "0.5.1",
  "publisher": "tcode",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:tcode"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "tcode",
        "extensions": [
          ".t"
        ],
        "aliases": [
          "Tcode"
        ],
        "icon": {
          "light": "./icons/tcode.svg",
          "dark": "./icons/tcode.svg"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "tcode",
        "scopeName": "source.tcode",
        "path": "./syntaxes/tcode.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[tcode]": {
        "editor.quickSuggestions": {
          "other": "on",
          "comments": "off",
          "strings": "on"
        }
      }
    },
    "configuration": {
      "title": "Tcode",
      "properties": {
        "tcode.lsp.tcodec": {
          "type": "string",
          "default": "tcodec",
          "description": "Ruta del binario tcodec."
        },
        "tcode.lsp.raiz": {
          "type": "string",
          "default": "",
          "description": "Raíz del proyecto (donde está std/). Vacío = la carpeta del espacio de trabajo."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.0",
    "vscode-languageserver": "^9.0.0",
    "vscode-languageserver-textdocument": "^1.0.0",
    "web-tree-sitter": "^0.27.0"
  },
  "scripts": {
    "package": "vsce package"
  }
}
