{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Tcode",
  "scopeName": "source.tcode",
  "fileTypes": ["t"],
  "patterns": [
    { "include": "#comentarios" },
    { "include": "#cadenas" },
    { "include": "#numeros" },
    { "include": "#funciones" },
    { "include": "#declaraciones" },
    { "include": "#funciones_internas" },
    { "include": "#tipos" },
    { "include": "#palabras_clave" },
    { "include": "#constantes" }
  ],
  "repository": {
    "comentarios": {
      "patterns": [
        { "name": "comment.line.double-slash.tcode", "match": "//.*$" },
        { "name": "comment.block.tcode", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "cadenas": {
      "patterns": [
        {
          "name": "string.quoted.double.tcode",
          "begin": "\\$?\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.tcode", "match": "\\\\." }
          ]
        }
      ]
    },
    "numeros": {
      "patterns": [
        { "name": "constant.numeric.hex.tcode", "match": "\\$[0-9A-Fa-f][0-9A-Fa-f_]*" },
        {
          "name": "constant.numeric.float.tcode",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.tcode",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "funciones": {
      "patterns": [
        {
          "name": "meta.function.tcode",
          "match": "\\b(fn)\\s+([A-Za-z_\\p{L}][A-Za-z0-9_\\p{L}\\p{N}]*)",
          "captures": {
            "1": { "name": "keyword.control.tcode" },
            "2": { "name": "entity.name.function.tcode" }
          }
        }
      ]
    },
    "funciones_internas": {
      "patterns": [
        {
          "name": "support.function.builtin.tcode",
          "match": "\\b(vacio|nuevo|vista|texto|empujar_byte|empujar|largo|byte|rebanar|igual|menor|imprimir_error|imprimir|anadir|truncar|ordenar|copiar|reservar|redimensionar|intercambiar|poner|obtener_mut|obtener|tiene|quitar|claves|raiz|piso|techo|redondear|absoluto|n_argumentos|argumento|leer_parte_archivo|leer_archivo|escribir_archivo|leer_linea|entrada_completa|variable_entorno|ahora_ms|monotono_ms|azar|sembrar)\\b(?=\\s*\\()"
        }
      ]
    },
    "declaraciones": {
      "patterns": [
        {
          "name": "meta.type.tcode",
          "match": "\\b(struct|enum)\\s+([A-Za-z_\\p{L}][A-Za-z0-9_\\p{L}\\p{N}]*)",
          "captures": {
            "1": { "name": "keyword.control.tcode" },
            "2": { "name": "entity.name.type.tcode" }
          }
        }
      ]
    },
    "tipos": {
      "name": "storage.type.tcode",
      "match": "\\b(str|view|usize|u8|u16|u32|u64|i8|i16|i32|i64|f32|f64|bool|map|list|bloque|cadena_c)\\b"
    },
    "palabras_clave": {
      "name": "keyword.control.tcode",
      "match": "\\b(fn|if|else|while|for|match|return|fail|break|continue|let|var|mut|try|sino|en|use|struct|enum|externo|como|anchor|drop|extends|protocol|implements)\\b"
    },
    "constantes": {
      "name": "constant.language.tcode",
      "match": "\\b(true|false)\\b"
    }
  }
}
