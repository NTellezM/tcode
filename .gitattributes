# El C que el compilador escribe de si mismo no es codigo fuente nuestro: que
# GitHub no lo cuente en la barra de lenguajes.
bootstrap/tcodec.c linguist-generated=true -diff

# La semilla fijada del banco de medidas: el mismo C generado, congelado.
bench/referencia/tcodec.c linguist-generated=true -diff

# El parser de tree-sitter y sus tablas los genera `tree-sitter generate`.
contrib/tree-sitter-tcode/src/parser.c linguist-generated=true -diff
contrib/tree-sitter-tcode/src/grammar.json linguist-generated=true -diff
contrib/tree-sitter-tcode/src/node-types.json linguist-generated=true -diff

# GitHub clasifica los `.t` por contenido y los confunde con C. Mientras TCode
# no este registrado en Linguist, se sacan de la barra: es lo que dice
# `contrib/linguist/README.md`. Cuando la propuesta de ese directorio este
# aceptada, esta linea se cambia por `*.t linguist-language=TCode`.
*.t -linguist-detectable
